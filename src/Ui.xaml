<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Ohman.MainWindow"
        Title="HP OMEN 4-Zone RGB Lighting"
        Width="780" Height="730"
        MinWidth="720" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="#161311"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

  <Window.Resources>
    <SolidColorBrush x:Key="Accent" Color="#FF0055"/>
    <SolidColorBrush x:Key="AccentHi" Color="#FF2D6E"/>
    <FontFamily x:Key="UiFont">Segoe UI, IBM Plex Sans, Arial</FontFamily>
    <FontFamily x:Key="MonoFont">Consolas, IBM Plex Mono, Courier New</FontFamily>
    <SolidColorBrush x:Key="Card" Color="#1C1816"/>
    <SolidColorBrush x:Key="Sunken" Color="#0D0B0A"/>
    <SolidColorBrush x:Key="Line" Color="#2A2522"/>
    <SolidColorBrush x:Key="LineHi" Color="#3D3733"/>
    <SolidColorBrush x:Key="Text" Color="#EDEAE8"/>
    <SolidColorBrush x:Key="TextHi" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Sub" Color="#96918D"/>
    <SolidColorBrush x:Key="Desc" Color="#807B77"/>
    <SolidColorBrush x:Key="SegText" Color="#A8A3A0"/>
    <SolidColorBrush x:Key="Pill" Color="#25201D"/>

    <!-- Sliders -->
    <Style x:Key="FlatSlider" TargetType="Slider">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid VerticalAlignment="Center">
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="Slider.DecreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource Accent}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="Slider.IncreaseLarge">
                    <RepeatButton.Template>
                      <ControlTemplate TargetType="RepeatButton">
                        <Border Height="6" CornerRadius="3" Background="{StaticResource LineHi}"/>
                      </ControlTemplate>
                    </RepeatButton.Template>
                  </RepeatButton>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Width="18" Height="18" Cursor="Hand">
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse Fill="#FFFFFF" Stroke="{StaticResource Accent}" StrokeThickness="3">
                          <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.45"/>
                          </Ellipse.Effect>
                        </Ellipse>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Sleek Button -->
    <Style x:Key="ActionButton" TargetType="Button">
      <Setter Property="Background" Value="{StaticResource Pill}"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#302B27"/>
                <Setter Property="BorderBrush" Value="{StaticResource LineHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Accent}"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- Header -->
      <RowDefinition Height="Auto"/>   <!-- Keyboard preview -->
      <RowDefinition Height="Auto"/>   <!-- Zone selection -->
      <RowDefinition Height="Auto"/>   <!-- Mode selection -->
      <RowDefinition Height="*"/>      <!-- Color customization & Sliders -->
      <RowDefinition Height="Auto"/>   <!-- Footer / Tray -->
    </Grid.RowDefinitions>

    <!-- 1. Header -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- App Title -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Border Width="16" Height="16" Background="{StaticResource Accent}" CornerRadius="3" Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
          <Border.RenderTransform>
            <RotateTransform Angle="45"/>
          </Border.RenderTransform>
        </Border>
        <TextBlock Text="OMEN 4-ZONE RGB LIGHTING" FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextHi}" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Status Indicator -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <Ellipse x:Name="DotStatus" Width="8" Height="8" Fill="#4AC06C" Margin="0,0,8,0" VerticalAlignment="Center"/>
        <TextBlock x:Name="TxtStatus" Text="Connected to HP Firmware (4 Zones)" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
      </StackPanel>

      <!-- Minimize to Tray Button -->
      <Button x:Name="BtnMinimizeTrayTop" Grid.Column="2" Style="{StaticResource ActionButton}" Content="Minimize to Tray" ToolTip="Keep keyboard lighting active and minimize to Windows system tray"/>
    </Grid>

    <!-- 2. Keyboard Map Visualizer Card -->
    <Border Grid.Row="1" Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,0,14">
      <StackPanel>
        <Grid Margin="0,0,0,8">
          <TextBlock Text="LIVE KEYBOARD MAP" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Desc}"/>
          <TextBlock x:Name="TxtSelectedInfo" Text="Select a zone or click any key" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/>
        </Grid>
        <Border x:Name="KbdHost" HorizontalAlignment="Center"/>
      </StackPanel>
    </Border>

    <!-- 3. Zone Selectors -->
    <Grid Grid.Row="2" Margin="0,0,0,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Text="ZONES" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Desc}" Margin="0,0,0,8"/>

      <UniformGrid Grid.Row="1" Rows="1" Columns="5">
        <!-- Zone 1: WASD -->
        <Border x:Name="BtnZoneWasd" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,6,0" Cursor="Hand">
          <StackPanel>
            <TextBlock Text="Zone 1: WASD" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
              <Border x:Name="SwatchWasd" Width="18" Height="18" CornerRadius="9" Background="#FF0055" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtHexWasd" Text="#FF0055" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Zone 2: Left -->
        <Border x:Name="BtnZoneLeft" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,6,0" Cursor="Hand">
          <StackPanel>
            <TextBlock Text="Zone 2: Left" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
              <Border x:Name="SwatchLeft" Width="18" Height="18" CornerRadius="9" Background="#9900FF" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtHexLeft" Text="#9900FF" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Zone 3: Middle -->
        <Border x:Name="BtnZoneMiddle" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,6,0" Cursor="Hand">
          <StackPanel>
            <TextBlock Text="Zone 3: Middle" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
              <Border x:Name="SwatchMiddle" Width="18" Height="18" CornerRadius="9" Background="#00EEFF" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtHexMiddle" Text="#00EEFF" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Zone 4: Right -->
        <Border x:Name="BtnZoneRight" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Margin="0,0,6,0" Cursor="Hand">
          <StackPanel>
            <TextBlock Text="Zone 4: Right / Num" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
              <Border x:Name="SwatchRight" Width="18" Height="18" CornerRadius="9" Background="#0099FF" BorderBrush="#FFFFFF" BorderThickness="1" Margin="0,0,6,0"/>
              <TextBlock x:Name="TxtHexRight" Text="#0099FF" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Sub}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- All Zones -->
        <Border x:Name="BtnZoneAll" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1.5" CornerRadius="8" Padding="10,8" Cursor="Hand">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="All 4 Zones" FontFamily="{StaticResource UiFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextHi}"/>
            <TextBlock Text="Apply to all" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Sub}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>
    </Grid>

    <!-- 4. Mode Selection -->
    <Grid Grid.Row="3" Margin="0,0,0,14">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="LIGHTING MODE" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Desc}" Margin="0,0,0,8"/>
      <Border x:Name="ModeSegHost" Grid.Row="1"/>
    </Grid>

    <!-- 5. Color Customization and Sliders -->
    <Grid Grid.Row="4" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="260"/>
      </Grid.ColumnDefinitions>

      <!-- Left Column: Color Palette & Strips -->
      <Border x:Name="ColorCard" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,12,0">
        <StackPanel>
          <TextBlock Text="ZONE COLOR CUSTOMIZER" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Desc}" Margin="0,0,0,10"/>

          <!-- Hex + Preview chip + Presets -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Color Swatch + Hex Input -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border x:Name="HexChip" Width="36" Height="36" Background="{StaticResource Accent}" CornerRadius="6" BorderBrush="{StaticResource LineHi}" BorderThickness="1" Margin="0,0,10,0"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="HEX CODE" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource Desc}"/>
                <TextBox x:Name="TxtHexInput" Text="#FF0055" FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextHi}" Background="{StaticResource Sunken}" BorderBrush="{StaticResource Line}" BorderThickness="1" Width="76" Padding="4,2" Margin="0,2,0,0"/>
              </StackPanel>
            </StackPanel>

            <!-- Preset Swatches -->
            <WrapPanel x:Name="PresetPalette" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
          </Grid>

          <!-- Hue Strip -->
          <TextBlock Text="HUE" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Desc}" Margin="0,2,0,4"/>
          <Border x:Name="HueHost" Height="28" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,10"/>

          <!-- Shade Strip -->
          <TextBlock Text="SHADE &amp; SATURATION" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource Desc}" Margin="0,0,0,4"/>
          <Border x:Name="ShadeHost" Height="28" CornerRadius="4" ClipToBounds="True"/>
        </StackPanel>
      </Border>

      <!-- Right Column: Sliders -->
      <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,14" Grid.Column="1">
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="CONTROLS" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Desc}" Margin="0,0,0,14"/>

          <!-- Brightness -->
          <Grid Margin="0,0,0,16">
            <TextBlock Text="Brightness" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextHi}"/>
            <TextBlock x:Name="TxtBrightnessVal" Text="100%" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/>
          </Grid>
          <Slider x:Name="SlBrightness" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10" Margin="0,0,0,20"/>

          <!-- Speed -->
          <Grid x:Name="SpeedHeader" Margin="0,0,0,16">
            <TextBlock Text="Animation Speed" FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextHi}"/>
            <TextBlock x:Name="TxtSpeedVal" Text="3" FontFamily="{StaticResource MonoFont}" FontSize="12.5" Foreground="{StaticResource Accent}" HorizontalAlignment="Right"/>
          </Grid>
          <Slider x:Name="SlSpeed" Style="{StaticResource FlatSlider}" Minimum="1" Maximum="5" Value="3" SmallChange="1" LargeChange="1" IsSnapToTickEnabled="True" TickFrequency="1"/>
          <TextBlock x:Name="TxtSpeedHint" Text="Adjusts wave, breathe and cycle speed" FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="{StaticResource Desc}" Margin="0,8,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- 6. Footer -->
    <Border Grid.Row="5" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
      <Grid>
        <TextBlock x:Name="TxtFooter" Text="OMEN 4-Zone RGB Lighting Utility • HP Omen 16 (am0279tx)" FontFamily="{StaticResource MonoFont}" FontSize="11" Foreground="{StaticResource Desc}" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnOffToggle" Style="{StaticResource ActionButton}" Content="Turn Off Backlight" Margin="0,0,10,0"/>
          <Button x:Name="BtnMinimizeTray" Style="{StaticResource ActionButton}" Content="Minimize to Tray"/>
        </StackPanel>
      </Grid>
    </Border>

  </Grid>
</Window>
